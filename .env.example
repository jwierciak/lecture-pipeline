# ==============================================================================
# Lecture Pipeline Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Required for semantic course/topic matching and note synthesis)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Watched directory for incoming lecture video/audio files
# Defaults to: ~/Documents/Wykłady
LECTURE_WATCH_DIR="~/Documents/Wykłady"

# Target Obsidian Vault directory for generated markdown notes
# Defaults to: ~/Library/Mobile Documents/com~apple~CloudDocs/Studia/Notatki
OBSIDIAN_VAULT_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Studia/Notatki"

# Temporary staging buffer directory during processing
# Defaults to: .staging/ inside project directory
# LECTURE_STAGING_DIR="./.staging"

# Custom courses catalog file (optional)
# Defaults to: courses.json inside project directory
# LECTURE_COURSES_FILE="./courses.json"

# Optional: Hugging Face User Access Token (suppresses unauthenticated download warnings)
# HF_TOKEN="your-hf-token-here"

